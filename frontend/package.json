{
  "name": "offlinenet",
  "version": "1.0.0",
  "description": "OfflineNet - A decentralized offline internet platform",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "keywords": [
    "electron",
    "offlinenet",
    "offline",
    "chat",
    "lan"
  ],
  "author": "Devendra Sai K",
  "license": "ISC",
  "build": {
    "appId": "com.offlinenet.app",
    "productName": "OfflineNet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "discovery.js",
      "backend.js"
    ],
    "win": {
      "target": "portable"
    }
  },
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "emoji-picker-react": "^4.19.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.3"
  }
}
